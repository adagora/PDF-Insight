#!/bin/sh
set -e
npx --no-install tsx scripts/check-secrets.ts
npx --no-install tsx scripts/check-comments.ts
npx --no-install prettier --check --log-level warn $(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|json|css|md|html|yml)$' | grep -vE '^(docs/api|tools)/' || true) 2>/dev/null || {
  echo "Prettier: run npm run format"; exit 1;
}
